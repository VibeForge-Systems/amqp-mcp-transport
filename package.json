{
  "name": "@vibeforge-systems/amqp-mcp-transport",
  "version": "1.3.0",
  "description": "MCP client and server transports over AMQP 0-9.1 (RabbitMQ), and binding-core for a proposed MCP-over-AMQP binding targeting MCP 2026-07-28",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./binding": {
      "types": "./dist/binding/index.d.ts",
      "import": "./dist/binding/index.js",
      "default": "./dist/binding/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:examples": "tsc -p tsconfig.examples.json",
    "prepare": "npm run build",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist dist-examples",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "example:server": "npm run build:examples && node dist-examples/examples/server.js",
    "example:client": "npm run build:examples && node dist-examples/examples/client.js",
    "lint": "eslint -c eslintrc.json \"src/**/*.ts\"",
    "lint:fix": "eslint -c eslintrc.json \"src/**/*.ts\" --fix"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "amqp",
    "rabbitmq",
    "transport",
    "typescript",
    "message-queue"
  ],
  "author": "VibeForge Systems, Inc. (https://www.vibeforgesystems.com/)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VibeForge-Systems/amqp-mcp-transport.git"
  },
  "homepage": "https://github.com/VibeForge-Systems/amqp-mcp-transport#readme",
  "bugs": {
    "url": "https://github.com/VibeForge-Systems/amqp-mcp-transport/issues"
  },
  "dependencies": {
    "@types/amqplib": "^0.10.5",
    "amqplib": "^0.10.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.2",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.17.1 <2"
  },
  "publishConfig": {
    "access": "public"
  }
}
